# Copy this file to .env and adjust if needed. docker-compose already sets
# these for the containers; .env is mainly for running services locally.

# Runtime identity (F05, docs/database-security.md): the unprivileged studygraph_app login that
# docker-compose's db-init creates. PostgreSQL is not published on the host; to use this URL from the
# host, publish it on loopback only (see docker-compose.yml, db service).
DATABASE_URL=postgresql+psycopg://studygraph_app:studygraph-app-dev-only@localhost:5432/studygraph
# Password db-init sets for studygraph_app (development only; default shown). Change both together.
# STUDYGRAPH_APP_DB_PASSWORD=studygraph-app-dev-only
# Migrations never use this runtime URL: `docker compose run --rm migrate` connects as the schema owner.
# Redis is not published on the host by docker-compose.yml; to use this URL from
# the host, publish it on loopback only (see docker-compose.yml, redis service).
REDIS_URL=redis://localhost:6379/0
AI_SERVICE_URL=http://localhost:8001
ENVIRONMENT=development
# Browser origins allowed to call core-api cross-origin: a JSON array of exact origins
# (scheme://host[:port], no trailing slash, no wildcards). Empty or unset: same-origin only.
# http and loopback origins are refused unless ENVIRONMENT is development or test; in
# staging/production list only https origins, e.g. ["https://studygraph.example.edu"].
# docs/frontend-exam-adaptation.md#browser-origins-and-readable-headers
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Uploaded files (docker-compose mounts the `uploads` volume here) and the
# largest accepted upload in bytes (default 26214400 = 25 MiB).
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=26214400

# Asynchronous processing (M3, docs/document-processing.md). Defaults shown; the
# settings refuse inconsistent limits (timeout < soft < hard limit, and so on).
# PARSE_TIMEOUT_SECONDS=120
# PARSE_MEMORY_LIMIT_MB=512
# PARSE_MAX_PAGES=1000
# PARSE_MAX_TEXT_CHARS=5000000
# PARSE_TASK_SOFT_TIME_LIMIT_SECONDS=150
# PARSE_TASK_TIME_LIMIT_SECONDS=180
# JOB_LEASE_MARGIN_SECONDS=120
# RETRY_BACKOFF_BASE_SECONDS=30
# RETRY_BACKOFF_MAX_SECONDS=600
# DISPATCH_ON_UPLOAD=false   (true publishes from the API; see the docs before enabling)
# DISPATCH_INTERVAL_SECONDS=10
# DISPATCH_BATCH_SIZE=100
# REDISPATCH_AFTER_SECONDS=300
# PUBLISH_RETRY_DELAY_SECONDS=30
# DISPATCH_MAX_QUEUE_DEPTH=100
# RECOVERY_INTERVAL_SECONDS=60
# RECONCILE_INTERVAL_SECONDS=3600
# RECONCILE_TEMP_GRACE_SECONDS=3600
# RECONCILE_ORPHAN_GRACE_SECONDS=86400
# BROKER_CONNECT_TIMEOUT_SECONDS=2
# BROKER_SOCKET_TIMEOUT_SECONDS=5
# BROKER_PUBLISH_ATTEMPTS=2
# AI indexing (M4, docs/ai-indexing-integration.md). Off by default.
# INDEXING_ENABLED=false
# INDEX_QUEUE=ingestion.index
# AI_SERVICE_TOKEN=           (required by the index worker when enabled; >= 32 chars; keep OUT of git)
# AI_CONNECT_TIMEOUT_SECONDS=3
# AI_READ_TIMEOUT_SECONDS=60
# AI_REQUEST_DEADLINE_SECONDS=150
# AI_PROBE_TIMEOUT_SECONDS=3
# AI_PROBE_CACHE_SECONDS=30
# INDEX_MAX_PAYLOAD_BYTES=16777216
# INDEX_MAX_RESPONSE_BYTES=65536
# INDEX_TASK_SOFT_TIME_LIMIT_SECONDS=240
# INDEX_TASK_TIME_LIMIT_SECONDS=270
# Course enrollment (M5, docs/courses-api.md). Single-process limiter.
# JOIN_RATE_LIMIT_ATTEMPTS=10
# JOIN_RATE_LIMIT_WINDOW_SECONDS=300
# JOIN_RATE_LIMIT_MAX_USERS=10000
# Course chat (M5, docs/ai-chat-integration.md). Off by default; uses AI_SERVICE_URL
# and AI_SERVICE_TOKEN. Only class_only is enabled by default; class_plus_web is refused.
# CHAT_ENABLED=false
# CHAT_ENABLED_SCOPES=class_only
# CHAT_MAX_BODY_BYTES=16384
# CHAT_BODY_TIMEOUT_SECONDS=10
# CHAT_MAX_QUESTION_CHARS=2000
# CHAT_MAX_CONCURRENT=8
# CHAT_MAX_CONCURRENT_PER_USER=1
# CHAT_CONNECT_TIMEOUT_SECONDS=3
# CHAT_READ_TIMEOUT_SECONDS=30
# CHAT_PROBE_DEADLINE_SECONDS=5
# CHAT_ANSWER_DEADLINE_SECONDS=60
# CHAT_DELIVERY_DEADLINE_SECONDS=15
# CHAT_MAX_RESPONSE_BYTES=262144
# CHAT_CAPABILITIES_CACHE_SECONDS=30

# --- Practice quizzes and graded attempts (M7, docs/quiz-api.md) -----------------------
# Off by default. Uses AI_SERVICE_URL and AI_SERVICE_TOKEN for generation only (the
# proposed studygraph.quiz/1 protocol, docs/ai-quiz-integration.md); grading is local.
# QUIZ_GENERATION_ENABLED / QUIZ_ATTEMPTS_ENABLED only take effect while QUIZ_ENABLED is on.
# Activation prerequisites: docs/quiz-api.md, "Activation".
# QUIZ_ENABLED=false
# QUIZ_GENERATION_ENABLED=true
# QUIZ_ATTEMPTS_ENABLED=true
# QUIZ_ENABLED_SCOPES=class_only            (the only scope in M7)
# QUIZ_MAX_BODY_BYTES=4096
# QUIZ_BODY_TIMEOUT_SECONDS=10
# QUIZ_MAX_QUESTIONS=10
# QUIZ_MAX_TOPICS=5
# QUIZ_MAX_CONCURRENT=4                      (per API process; one per user, also enforced by the database)
# QUIZ_DAILY_GENERATION_QUOTA=20             (per student and UTC day, database counter)
# QUIZ_QUOTA_RETENTION_DAYS=14
# QUIZ_CONNECT_TIMEOUT_SECONDS=3
# QUIZ_READ_TIMEOUT_SECONDS=30
# QUIZ_PROBE_DEADLINE_SECONDS=5
# QUIZ_GENERATE_DEADLINE_SECONDS=45
# QUIZ_PIPELINE_DEADLINE_SECONDS=60          (must exceed probe + generate deadlines)
# QUIZ_LEASE_MARGIN_SECONDS=30               (lease = pipeline deadline + margin, database time)
# QUIZ_MAX_RESPONSE_BYTES=262144
# QUIZ_CAPABILITIES_CACHE_SECONDS=30

# --- External harvesting (M6, docs/external-harvesting.md) ---------------------------
# Off by default. Even when on, nothing is harvested until an operator creates and
# enables a provider source, opts a course in and approves each query (app.harvest.admin).
# Only Wikipedia is implemented. Restrict the harvest worker's egress in infrastructure
# (separate prerequisite; docker-compose.yml does not provide it).
# HARVEST_ENABLED=false          (must be true on BOTH worker-maintenance and worker-harvest to harvest)
# HARVEST_USER_AGENT=          (required by the harvest worker when enabled; Wikimedia policy:
#                               "StudyGraphHarvester/1.0 (https://your.site/contact; ops@your.site)")
# HARVEST_QUEUE=harvest.run
# HARVEST_RUN_MAX_REQUESTS=300
# HARVEST_DEFAULT_MAX_ACTIVE_DOCUMENTS=20
# EXTERNAL_INDEX_DEFER_SECONDS=900

# --- Dashboard, analytics, study events, mastery delivery (M8) -----------------------
# docs/dashboard-api.md, docs/analytics-privacy.md, docs/study-events.md,
# docs/ai-mastery-integration.md. Activation prerequisites are listed in each document.
# DASHBOARD_ENABLED=true             (deterministic, read-only, no AI involved)
# ANALYTICS_ENABLED=false            (off until the privacy review approves it)
# ANALYTICS_MIN_GROUP_SIZE=5         (distinct contributing students per released cell; never below 5)
# ANALYTICS_PUBLICATION_DELAY_SECONDS=21600   (a completed UTC week is released >= 6 h after it ended)
# ANALYTICS_WEEKS=12
# STUDY_EVENTS_ENABLED=false         (client telemetry; off until approved)
# STUDY_EVENTS_DAILY_QUOTA=2000      (per student and UTC day, database-enforced)
# STUDY_EVENTS_RETENTION_DAYS=180    (>= 2)
# AI_RECOMMENDATIONS_ENABLED=false   (cannot be enabled: no AI recommendation integration exists)
# MASTERY_DELIVERY_ENABLED=false     (must be true on BOTH worker-maintenance and worker-mastery to deliver;
#                                     outbox events are written whatever it says)
# MASTERY_QUEUE=mastery.deliver
# Pinned model and pseudonyms (all required while delivery is enabled; agreed with AI-2):
# MASTERY_MODEL_NAME=
# MASTERY_MODEL_VERSION=
# MASTERY_STATE_EPOCH=               (lower-case UUID)
# MASTERY_PSEUDONYM_NAMESPACE=       (per deployment, e.g. studygraph-staging)
# MASTERY_PSEUDONYM_KEY=             (secret, >= 32 characters; never commit it, never reuse across deployments)
# MASTERY_MAX_BATCH_EVENTS=100
# MASTERY_MAX_FAILURES=10            (failed deliveries of one batch before the stream is blocked)
# MASTERY_PREDICTION_MAX_AGE_DAYS=30

# --- Professor exams (M9-A1) ----------------------------------------------------------
# docs/exam-api.md, docs/exam-export.md. Every switch is OFF and fails closed (503 after
# authorization). Activation prerequisites: docs/exam-api.md "Activation".
# EXAMS_ENABLED=false
# EXAM_EXPORT_ENABLED=false          (needs EXAMS_ENABLED; JSON preview works without it)
# EXAM_GENERATION_ENABLED=false      (M9-A2 only; refused while no approved AI-1 protocol exists)
# EXAM_MAX_BODY_BYTES=65536
# EXAM_MAX_ITEMS=200
# EXAM_MAX_BANK_QUESTIONS=5000       (per course)
# EXAM_MAX_EXAMS=500                 (per course)
# EXAM_EXPORT_MAX_CONTENT_CHARS=300000   (printable code points per exam; <= 300000, calibrated by EXP-16)
# EXAM_EXPORT_MAX_CONCURRENT=2       (renders per API process; one per professor)
# EXAM_EXPORT_RATE_LIMIT=30          (files per EXAM_EXPORT_RATE_WINDOW_SECONDS per professor, per process)
# EXAM_EXPORT_RATE_WINDOW_SECONDS=600
# EXAM_EXPORT_TIMEOUT_SECONDS=30     (wall clock; must exceed EXAM_EXPORT_CPU_SECONDS)
# EXAM_EXPORT_CPU_SECONDS=25
# EXAM_EXPORT_MEMORY_MB=512
# EXAM_EXPORT_MAX_PDF_BYTES=16777216
# EXAM_EXPORT_MAX_DOCX_BYTES=8388608

# Added later, keep OUT of git:
# OPENALEX_API_KEY=
# WEB_SEARCH_API_KEY=
# LLM_API_KEY=
# JWT_SECRET=
